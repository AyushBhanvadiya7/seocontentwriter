# PostgreSQL
# Runtime: use the pooled connection (for example, Neon via the Vercel Marketplace).
DATABASE_URL=""
# Migrations: direct, unpooled connection when your provider supplies one.
DATABASE_URL_UNPOOLED=""
# Optional. Vercel defaults to 1 connection per function instance; local default is 10.
DB_POOL_MAX=""

# Required in production. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Canonical origin. Leave blank locally to use http://localhost:3000.
# In Vercel, set this to your public https:// domain (or use Vercel's system URL fallback).
SITE_URL=""
NEXT_PUBLIC_SITE_URL=""
NEXT_PUBLIC_APP_URL=""
NEXT_PUBLIC_APP_NAME="SEO Content Writer"

# AI — configure at least ONE provider to generate articles.
# Provider priority: AIMLAPI, then Gemini, then OpenAI.
AIMLAPI_KEY=""
AIMLAPI_MODEL="openai/gpt-5-5"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# SERP research (optional; get a key from Serper.dev).
SERPER_API_KEY=""
SERPER_GL="in"
SERPER_HL="en"

# Email (needed for verification, password reset and admin OTP emails).
RESEND_API_KEY=""
EMAIL_FROM="SEO Content Writer <no-reply@example.com>"
CONTACT_TO="support@example.com"

# Razorpay payments (optional; never expose the secret in a NEXT_PUBLIC_ variable).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# The Key ID is public and this is optional; the API can return RAZORPAY_KEY_ID instead.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Sentry (optional error reporting; AUTH_TOKEN/ORG/PROJECT enable source-map upload).
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Local development only. Vercel's filesystem is ephemeral; uploads are parsed per request.
UPLOAD_DIR="./uploads"

# Used only when you explicitly run npm run db:seed. Choose a unique admin email
# and a strong password (at least 16 characters); never commit these values.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
